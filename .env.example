# Copy to .env and adjust. Never commit real credentials.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:15433/sentinel_registry
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:15173
SEED_DEMO_DATA=true
LOG_LEVEL=info
